# LLM providers — fallback chain: OpenRouter (free models) -> NVIDIA NIM -> Groq
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# Run entirely offline with a deterministic fake LLM (tests/demo)
LLM_FAKE_MODE=false

# Database. SQLite default; set a postgres:// / postgresql:// URL to switch
# (scheme is normalized and psycopg2 is pinned in app/db/engine.py).
DATABASE_URL=sqlite:///data/app.db

LOG_LEVEL=INFO

# Data collection (EPIC-02+)
APIFY_TOKEN=
# Scraping public LinkedIn pages violates LinkedIn's ToS. Both this env var AND
# collection.allow_scraping in config/app.yaml must be set to enable it.
ACKNOWLEDGE_LINKEDIN_TOS=false
